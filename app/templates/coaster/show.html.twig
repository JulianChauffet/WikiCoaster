{% extends 'base.html.twig' %}

{% block title %}Coaster{% endblock %}

{% block body %}
    <h1>Coaster</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ coaster.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ coaster.name }}</td>
            </tr>
            <tr>
                <th>MaxSpeed</th>
                <td>{{ coaster.maxSpeed }}</td>
            </tr>
            <tr>
                <th>Length</th>
                <td>{{ coaster.length }}</td>
            </tr>
            <tr>
                <th>MaxHeight</th>
                <td>{{ coaster.maxHeight }}</td>
            </tr>
            <tr>
                <th>Operating</th>
                <td>{{ coaster.operating ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_coaster_index') }}">back to list</a>

    <a href="{{ path('app_coaster_edit', {'id': coaster.id}) }}">edit</a>

    {{ include('coaster/_delete_form.html.twig') }}
{% endblock %}
